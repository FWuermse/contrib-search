# If you're not using docker
KIND_EXPERIMENTAL_PROVIDER=podman
# Path to your local Platform Mesh setup (used by hack/kubeconfig-copy.sh)
PORTAL_DIRECTORY=/path/to/your/local-setup

# KCP kubeconfig path
KUBECONFIG=/path/to/kcp-kubeconfig

# OpenSearch credentials (read by config.go via os.Getenv)
OPENSEARCH_USERNAME=admin
OPENSEARCH_PASSWORD=admin

# Organization to use when request host is localhost (defaults to "local" if unset)
SEARCH_LOCAL_ORG=local