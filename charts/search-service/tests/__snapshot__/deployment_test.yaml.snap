service matches the snapshot:
  1: |
    apiVersion: rbac.authorization.k8s.io/v1
    kind: ClusterRole
    metadata:
      name: RELEASE-NAME-search-service
    rules:
      - apiGroups:
          - authentication.k8s.io
        resources:
          - tokenreviews
        verbs:
          - create
  2: |
    apiVersion: rbac.authorization.k8s.io/v1
    kind: ClusterRoleBinding
    metadata:
      name: RELEASE-NAME-search-service
    roleRef:
      apiGroup: rbac.authorization.k8s.io
      kind: ClusterRole
      name: RELEASE-NAME-search-service
    subjects:
      - kind: ServiceAccount
        name: RELEASE-NAME-search-service
        namespace: NAMESPACE
  3: |
    apiVersion: apps/v1
    kind: Deployment
    metadata:
      name: RELEASE-NAME-search-service
      namespace: NAMESPACE
    spec:
      replicas: 1
      revisionHistoryLimit: 3
      selector:
        matchLabels:
          app: RELEASE-NAME-search-service
      template:
        metadata:
          labels:
            app: RELEASE-NAME-search-service
            service: RELEASE-NAME-search-service
        spec:
          automountServiceAccountToken: true
          containers:
            - args:
                - serve
                - --port=8080
                - --log-level=info
                - --kubeconfig=/api-kubeconfig/kubeconfig
                - --is-local=true
                - --local-development-org=sap
                - --opensearch-url=http://opensearch-cluster-master.platform-mesh-system.svc.cluster.local:9200
                - --opensearch-insecure=true
                - --opensearch-timeout=10s
                - --openfga-grpc-addr=openfga.platform-mesh-system.svc.cluster.local:8081
                - --searchindex-workspace-path=root:providers:search
                - --searchindex-org-workspace-path=root:orgs
                - --searchindex-token-review-workspace-path=root:orgs
                - --searchindex-group=search.platform-mesh.io
                - --searchindex-version=v1alpha1
                - --searchindex-resource=searchindexes
                - --search-default-limit=20
                - --search-max-limit=100
                - --search-fetch-batch-size=100
                - --search-max-scanned-hits=1000
              env:
                - name: KCP_KUBECONFIG
                  value: /api-kubeconfig/kubeconfig
                - name: OPENSEARCH_URL
                  value: http://opensearch-cluster-master.platform-mesh-system.svc.cluster.local:9200
                - name: OPENSEARCH_USERNAME
                  value: admin
                - name: OPENSEARCH_PASSWORD
                  valueFrom:
                    secretKeyRef:
                      key: password
                      name: opensearch-admin-auth
              image: ghcr.io/platform-mesh/platform-mesh/search-service:latest
              imagePullPolicy: Always
              livenessProbe:
                failureThreshold: 3
                httpGet:
                  path: /healthz
                  port: http
                periodSeconds: 10
              name: RELEASE-NAME-search-service
              ports:
                - containerPort: 8080
                  name: http
                  protocol: TCP
              readinessProbe:
                httpGet:
                  path: /readyz
                  port: http
                initialDelaySeconds: 5
                periodSeconds: 10
              resources:
                limits:
                  cpu: 260m
                  memory: 512Mi
                requests:
                  cpu: 100m
                  memory: 128Mi
              securityContext:
                readOnlyRootFilesystem: true
                runAsNonRoot: true
                seccompProfile:
                  type: RuntimeDefault
              startupProbe:
                failureThreshold: 30
                httpGet:
                  path: /readyz
                  port: http
                periodSeconds: 10
              volumeMounts:
                - mountPath: /api-kubeconfig
                  name: external-api-server
          hostAliases:
            - hostnames:
                - localhost
                - portal.localhost
                - kcp.localhost
                - root.kcp.localhost
                - nereus.kcp.localhost
                - triton.kcp.localhost
              ip: 10.96.188.4
          securityContext:
            runAsNonRoot: true
            seccompProfile:
              type: RuntimeDefault
          serviceAccountName: RELEASE-NAME-search-service
          terminationGracePeriodSeconds: 10
          volumes:
            - name: external-api-server
              secret:
                secretName: search-service-kubeconfig
  4: |
    apiVersion: gateway.networking.k8s.io/v1
    kind: HTTPRoute
    metadata:
      name: RELEASE-NAME-search-service
      namespace: NAMESPACE
    spec:
      hostnames:
        - portal.localhost
        - '*.portal.localhost'
      parentRefs:
        - name: k8sapi-gateway
      rules:
        - backendRefs:
            - group: ""
              kind: Service
              name: RELEASE-NAME-search-service
              namespace: NAMESPACE
              port: 8080
          matches:
            - path:
                type: PathPrefix
                value: /rest/v1/search
  5: |
    apiVersion: v1
    kind: ServiceAccount
    metadata:
      name: RELEASE-NAME-search-service
      namespace: NAMESPACE
  6: |
    apiVersion: v1
    kind: Service
    metadata:
      labels:
        app: RELEASE-NAME-search-service
      name: RELEASE-NAME-search-service
      namespace: NAMESPACE
    spec:
      ports:
        - name: http
          port: 8080
          protocol: TCP
          targetPort: http
      selector:
        app: RELEASE-NAME-search-service
      type: ClusterIP
